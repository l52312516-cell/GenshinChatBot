1 ICON "assets\\icon.ico"
1 24 "assets\\app.manifest"

1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "CompanyName", "ChatGIBot Project\0"
            VALUE "FileDescription", "ChatGIBot Native\0"
            VALUE "FileVersion", "1.0.0\0"
            VALUE "InternalName", "ChatGIBotNative\0"
            VALUE "OriginalFilename", "ChatGIBotNative.exe\0"
            VALUE "ProductName", "ChatGIBot Native\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
